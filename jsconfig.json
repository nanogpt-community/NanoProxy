{
  "compilerOptions": {
    "checkJs": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.js",
    "**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "Logs"
  ]
}
